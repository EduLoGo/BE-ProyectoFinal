<section class="container">
  <article class="card m-2 col-12 shadowBox" id="{{product.id}}">
    <div class="row g-0">
      <div class="col-md-4 d-flex justify-content-center align-items-center">
        <img
          src={{product.thumbnail}}
          class="img-fluid rounded-start d-flex justify-content-center align-items-center"
          alt={{product.title}}
        />
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h3 class="card-title d-flex justify-content-center">{{product.title}}</h3>
          <p class="card-text">{{product.description}}</p>
          <p class="card-text d-flex justify-content-center">
            <strong>${{product.price}}</strong>
          </p>
          <p class="card-text d-flex justify-content-end">Stock: {{product.stock}}
          </p>
          <p class="card-text d-flex justify-content-end">
            <small class="text-body-secondary">Categoría: {{product.category}}</small>
          </p>
          <p class="card-text d-flex justify-content-end">
            <small class="text-body-secondary">Codigo: {{product.code}}</small>
          </p>
        </div>
      </div>
    </div>
  </article>
  <div class="d-flex justify-content-around">
    <a href="/products" class="btn btn-primary w-25">Volver</a>
    <a href="/products" class="btn btn-primary w-25">Agregar al Carrito</a>
  </div>
</section>