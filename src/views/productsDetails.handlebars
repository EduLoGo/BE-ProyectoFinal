<section class="container">
  <article class="card px-5 m-2 my-5 col-12 shadowBox" id="{{product.id}}">
    <div class="row g-0">
      <div class="col-md-4 d-flex justify-content-center align-items-center">
        <img
          src={{product.thumbnail}}
          class="img-fluid rounded-start d-flex justify-content-center align-items-center py-3"
          alt={{product.title}}
        />
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h3 class="card-title d-flex justify-content-center">{{product.title}}</h3>
          <p class="card-text">{{product.description}}</p>
          <p class="card-text d-flex justify-content-center">
            <strong>${{product.price}}</strong>
          </p>
          <p class="card-text d-flex justify-content-end">Stock: {{product.stock}}
          </p>
          <p class="card-text d-flex justify-content-end">
            <small class="text-body-secondary">Categoría: {{product.category}}</small>
          </p>
          <p class="card-text d-flex justify-content-end">
            <small class="text-body-secondary">Código: {{product.code}}</small>
          </p>
        </div>
      </div>
    </div>
  </article>
  <div class="d-flex justify-content-around">
    <button class="btn btn-primary w-25" onclick="volver()">Volver</button>
    <a href="" class="btn btn-primary w-25">Agregar al Carrito</a>
  </div>
</section>
<script>
        function volver() {
            window.history.back();
        }
</script>