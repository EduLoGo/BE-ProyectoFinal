<div
  class="container d-flex justify-content-center align-items-center mt-5 p-5"
>
  <div class="card text-white p-3 loginbox" style="width: 30rem;">
    <h3 class="mb-3 text-center">Iniciar Sesión</h3>
    <form action="/api/sessions/login" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label markRequired">Correo Electrónico:
        </label>
        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label markRequired">Contraseña:
        </label>
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          required
        />
      </div>
      <div class="d-flex justify-content-around">
        <a href="/register" class="btn btn-secondary">Crear Usuario</a>
        <button type="submit" class="btn btn-primary">Ingresar</button>
      </div>
    </form>
  </div>
</div>
{{#if errorMessage}}
  <div class="container d-flex justify-content-center align-items-center">
    <div class="alert alert-danger text-center" style="width: 10rem;" role="alert">
      <p>{{errorMessage}}</p>
    </div>
  </div>
{{/if}}